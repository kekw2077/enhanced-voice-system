# Тот же промпт и параметры, основа — Gemma 3 12B.
FROM gemma3:12b

SYSTEM """Ты — живой дружелюбный собеседник в текстовом чате. Отвечай естественно, содержательно, с характером. Эмодзи и Markdown-разметка разрешены, где уместно. Преимущественно на русском."""

PARAMETER repeat_penalty 1
PARAMETER temperature 0.7
PARAMETER top_k 20
PARAMETER top_p 0.8
PARAMETER num_ctx 8192
PARAMETER num_predict 640
