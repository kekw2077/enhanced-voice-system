# Клон голоса XTTS-v2 на видеокарте AMD. Тяжёлая часть — в общей основе
# evs-rocm-base, здесь только пакет синтеза.
#
# Сервер тот же файл, что лежит в sidecar/: он спрашивает у torch, есть ли
# карта, а не какого она производителя, — значит чинить придётся одно место.
FROM evs-rocm-base:latest

ENV HF_HOME=/models/.hf \
    TTS_HOME=/models \
    XTTS_CACHE=/models \
    # Веса XTTS-v2 под лицензией CPML. Без этого согласия загрузчик
    # останавливается и ждёт ответа в консоли, которой у контейнера нет, —
    # сервер просто молча висит на старте.
    COQUI_TOS_AGREED=1

# coqui-tts — поддерживаемая ветка заброшенного Coqui TTS. Torch она за собой
# НЕ тянет: сборка под ROCm из основы остаётся, проверено.
#
# transformers закреплён по пятую ветку, и это не осторожность, а замер: в
# transformers 5 убрали `isin_mps_friendly`, который импортирует GPT-часть
# XTTS. Симптом ровно один — 500 на любом синтезе и строчка «cannot import
# name isin_mps_friendly» в логе. С 4.57 всё работает.
#
# torchcodec ставится, но НЕ используется, и это не оплошность. С torch 2.9
# coqui-tts отказывается читать аудио без него — проверяет наличие пакета до
# всякого чтения и падает с советом поставить `coqui-tts[codec]`. А его
# библиотеки линкуются с libtorch по строгой паре версий и на этой сборке не
# грузятся («Could not load this library»). Поэтому пакет присутствует ради
# проверки, а образец сервер читает сам модулем `wave` — см.
# `_patch_audio_loader` в xtts_server.py. Убрать одно без другого нельзя:
# без пакета не проходит проверка, без своего загрузчика падает чтение.
RUN pip install --no-cache-dir coqui-tts "transformers<5" torchcodec

COPY xtts_server.py /opt/server.py

# Веса (~2 ГБ) живут в томе: переживают пересборку образа и не раздувают его.
VOLUME ["/models"]
EXPOSE 8762
CMD ["python3", "/opt/server.py", "--host", "0.0.0.0", "--port", "8762", \
     "--cache-dir", "/models"]
